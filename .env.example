# Supabase project — create one at https://supabase.com/dashboard and
# copy these from Project Settings > API. Copy this file to .env.local
# and fill in real values; .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses Row Level Security. Server-only, never
# exposed to the browser. Treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=
